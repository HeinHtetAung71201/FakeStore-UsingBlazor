@page "/shop"

@rendermode InteractiveServer

@using FakeWebStore.Models
@using FakeWebStore.Services

@inject HttpClient Http
@inject CartService CartService
@inject IJSRuntime JS

<div class="container my-0">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 sticky-top bg-white py-3"
         style="top: 0; z-index: 1000;">

        <!-- Page Title -->
        <h2 class="mb-0">Products</h2>

        <div class="input-group " style="max-width: 400px;">

            <span class="input-group-text">
                <i class="bi bi-search"></i>
            </span>

            <input type="text"
                class="form-control"
                placeholder="Search products..."
                @bind="searchText"
                @bind:event="oninput" />


        </div>
        <!-- Right Side -->
        <div class="d-flex align-items-center gap-2">

            <!-- Logged In User -->
            @if (isLoggedIn)
            {
                <div class="dropdown">
                    <button class="btn btn-light border rounded-pill px-3"
                            type="button"
                            @onclick="ToggleUserMenu">

                        <i class="bi bi-person-circle me-1"></i>

                        <span>@username</span>

                        <i class="bi bi-chevron-down ms-1"></i>
                    </button>

                    @if (showUserMenu)
                    {
                        <div class="position-absolute bg-white border rounded-3 shadow-sm p-2 mt-2"
                             style="right: 0; min-width: 180px; z-index: 1100;">

                            <div class="px-3 py-2 border-bottom">
                                <small class="text-muted">Logged in as</small>
                                <div class="fw-bold">
                                    @username
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <a href="/"
                   class="btn btn-outline-primary rounded-pill">
                    <i class="bi bi-person me-1"></i>
                    Login
                </a>
            }

            <!-- Cart -->
            <a href="/cart"
               class="btn btn-outline-primary rounded-pill">

                <i class="bi bi-cart"></i>

                Cart

                <span class="badge bg-primary">
                    @CartService.CartCount
                </span>

            </a>

        </div>
    </div>


    <!-- Products -->
    @if (products == null)
    {
        <div class="text-center py-5 w-full h-100 d-flex flex-column align-items-center justify-content-center">

            <div class="spinner-border text-primary"></div>

            <p class="mt-2">
                Loading products...
            </p>

        </div>
    }
    else if (products.Count == 0)
    {
        <div class="alert alert-warning">
            No products found.
        </div>
    }
    else
    {
        <div class="row">

            @foreach (var product in FilteredProducts)
            {
                <div class="col-md-3 mb-4">

                    <div class="card h-100 shadow-sm border-0 rounded-4">

                        <!-- Product Image -->
                        <div class="p-3 text-center"
                             style="cursor:pointer;"
                             @onclick="() => OpenDetail(product)">

                            <img src="@product.Thumbnail"
                                 class="card-img-top"
                                 style="height:180px; object-fit:contain;"
                                 alt="@product.Title" />

                        </div>


                        <!-- Product Information -->
                        <div class="card-body d-flex flex-column">

                            <span class="badge bg-secondary mb-2 text-uppercase">
                                @product.Category
                            </span>

                            <h5 class="card-title fs-6 text-truncate"
                                style="cursor:pointer;"
                                @onclick="() => OpenDetail(product)">

                                @product.Title

                            </h5>

                            <p class="text-primary fw-bold fs-5">
                                $@product.Price.ToString("N2")
                            </p>

                            <p class="text-warning small">
                                ⭐ @product.Rating / 5
                            </p>

                            <!-- Add To Cart -->
                            <button class="btn btn-outline-primary w-100 mt-auto rounded-pill"
                                    @onclick="() => AddToCart(product)">

                                <i class="bi bi-cart-plus"></i>

                                Add to Cart

                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>
    }


</div>


<!-- Product Detail Modal -->
@if (selectedProduct != null)
{
    <div class="modal show d-block"
         tabindex="-1"
         style="background:rgba(0,0,0,0.5);">

        <div class="modal-dialog modal-lg modal-dialog-centered">

            <div class="modal-content rounded-4">

                <!-- Header -->
                <div class="modal-header border-0">

                    <h5 class="modal-title">
                        Product Details
                    </h5>

                    <button type="button"
                            class="btn-close"
                            @onclick="CloseDetail">
                    </button>

                </div>


                <!-- Body -->
                <div class="modal-body">

                    <div class="row">

                        <!-- Image -->
                        <div class="col-md-5 text-center">

                            <img src="@selectedProduct.Thumbnail"
                                 class="img-fluid"
                                 style="max-height:300px; object-fit:contain;" />

                        </div>


                        <!-- Details -->
                        <div class="col-md-7">

                            <span class="badge bg-info text-dark mb-2 text-uppercase">
                                @selectedProduct.Category
                            </span>

                            <h3>
                                @selectedProduct.Title
                            </h3>

                            <p class="text-muted">
                                @selectedProduct.Description
                            </p>

                            <div class="mb-3">

                                <span class="text-warning">
                                    ⭐ @selectedProduct.Rating / 5
                                </span>

                            </div>

                            <h3 class="text-primary fw-bold">
                                $@selectedProduct.Price.ToString("N2")
                            </h3>

                            @if (selectedProduct.DiscountPercentage > 0)
                            {
                                <p class="text-success">
                                    @selectedProduct.DiscountPercentage% OFF
                                </p>
                            }

                            <p class="small text-muted">
                                Brand: @selectedProduct.Brand
                            </p>

                            <p class="small">
                                Stock:
                                <strong>
                                    @selectedProduct.Stock
                                </strong>
                            </p>

                            <!-- Add To Cart -->
                            <button class="btn btn-primary rounded-pill px-4"
                                    @onclick="() => AddAndClose(selectedProduct)">

                                <i class="bi bi-cart-plus"></i>

                                Add to Cart

                            </button>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
}


@code {

private string searchText = "";

private List<Product> products = new();

private IEnumerable<Product> FilteredProducts
{
    get
    {
        if (string.IsNullOrWhiteSpace(searchText))
        {
            return products;
        }

        return products.Where(p =>
            p.Title.Contains(
                searchText.Trim(),
                StringComparison.OrdinalIgnoreCase
            )
        );
    }
}

private void ClearSearch()
{
    searchText = "";
}


    private Product? selectedProduct;


    private string? username;

    private bool isLoggedIn = false;

    private bool showUserMenu = false;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response =
                await Http.GetFromJsonAsync<ProductResponse>(
                    "https://dummyjson.com/products"
                );

            products = response?.Products ?? new List<Product>();
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Error loading products: {ex.Message}"
            );

            products = new List<Product>();
        }

        // Check login status
        await CheckLoginStatus();
    }

    private async Task CheckLoginStatus()
    {
        try
        {
            username = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "userName"
            );

            isLoggedIn = !string.IsNullOrWhiteSpace(username);
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Login check error: {ex.Message}"
            );

            isLoggedIn = false;
            username = null;
        }
    }


    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private void OpenDetail(Product product)
    {
        selectedProduct = product;
    }


    private void CloseDetail()
    {
        selectedProduct = null;
    }


    private void AddToCart(Product product)
    {
        CartService.AddToCart(product);

        Console.WriteLine(
            $"Added {product.Title} to cart. " +
            $"Total items: {CartService.CartCount}"
        );
    }


    private void AddAndClose(Product product)
    {
        CartService.AddToCart(product);

        selectedProduct = null;
    }

}