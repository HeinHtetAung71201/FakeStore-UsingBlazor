@page "/cart"
@rendermode InteractiveServer

@using FakeWebStore.Models
@using FakeWebStore.Services
@inject HttpClient Http
@inject IJSRuntime JS
@inject CartService CartService

@implements IDisposable

<div class="container my-0">
    @if (!string.IsNullOrEmpty(notificationMessage))
{
    <div class="alert @notificationClass alert-dismissible fade show shadow-sm"
         role="alert">
        <i class="@notificationIcon me-2"></i>
        @notificationMessage

       
    </div>
}

    <div class="d-flex justify-content-between align-items-center mb-4 sticky-top bg-white py-3"
            style="top: 0; z-index: 1000;">
        <h2 class="mb-4">Shopping Cart</h2>

        <div class="d-flex align-items-center gap-2">

            <!-- Logged In User -->
            @if (isLoggedIn)
            {
                <div class="dropdown">
                    <button class="btn btn-light border rounded-pill px-3"
                            type="button"
                            @onclick="ToggleUserMenu">

                        <i class="bi bi-person-circle me-1"></i>

                        <span>@username</span>

                        <i class="bi bi-chevron-down ms-1"></i>
                    </button>

                    @if (showUserMenu)
                    {
                        <div class="position-absolute bg-white border rounded-3 shadow-sm p-2 mt-2"
                             style="right: 0; min-width: 180px; z-index: 1100;">

                            <div class="px-3 py-2 border-bottom">
                                <small class="text-muted">Logged in as</small>
                                <div class="fw-bold">
                                    @username
                                </div>
                            </div>

                        </div>
                    }
                </div>
            }
            else
            {
                <a href="/login"
                   class="btn btn-outline-primary rounded-pill">
                    <i class="bi bi-person me-1"></i>
                    Login
                </a>
            }

        </div>
    </div>

    @if (CartService.CartItems.Count == 0)
    {
        <div class="alert alert-info text-center w-100 vh-100 d-flex align-items-center justify-content-center">
            Your cart is empty.
        </div>
    }
    else
    {
        <div class="card shadow-sm border-0 rounded-4 p-4">

            <table class="table align-middle">

                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Price</th>
                        <th>Quantity</th>
                        <th>Total</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in CartService.CartItems)
                    {
                        <tr>

                            <!-- Product -->
                            <td>
                                <div class="d-flex align-items-center">

                                    <img src="@item.Product.Thumbnail"
                                         width="60"
                                         height="60"
                                         style="object-fit: contain;"
                                         class="me-3" />

                                    <span>
                                        @item.Product.Title
                                    </span>

                                </div>
                            </td>


                            <!-- Price -->
                            <td>
                                $@item.Product.Price.ToString("N2")
                            </td>


                            <!-- Quantity -->
                            <td>

                                <div class="d-flex align-items-center">

                                    <button class="btn btn-sm btn-outline-secondary rounded-circle"
                                            @onclick="() => DecreaseQuantity(item.Product.Id)">
                                        -
                                    </button>

                                    <span class="mx-3 fw-bold">
                                        @item.Quantity
                                    </span>

                                    <button class="btn btn-sm btn-outline-secondary rounded-circle"
                                            @onclick="() => IncreaseQuantity(item.Product.Id)">
                                        +
                                    </button>

                                </div>

                            </td>


                            <!-- Total -->
                            <td class="fw-bold">

                                $@item.TotalPrice.ToString("N2")

                            </td>


                            <!-- Remove -->
                            <td>

                                <button class="btn btn-sm btn-outline-danger rounded-pill px-3"
                                        @onclick="() => RemoveItem(item.Product.Id)">

                                    <i class="bi bi-trash"></i>
                                    Remove

                                </button>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>


            <!-- Cart Summary -->

            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">

                <div>
                    <span class="text-muted">
                        @CartService.CartCount item(s)
                    </span>
                </div>

                <div class="text-end">

                    <h4>
                        Total Amount:
                        <span class="text-primary">
                            $@CartService.CartTotal.ToString("N2")
                        </span>
                    </h4>

                    <button class="btn btn-success rounded-pill px-4"
                            @onclick="ProceedToCheckout">
                        <i class="bi bi-cart-check me-1"></i>
                        Proceed to Checkout
                    </button>

                </div>

            </div>

        </div>
    }

</div>


@code {

    private string? username;

    private bool isLoggedIn = false;

    private bool showUserMenu = false;

    private string? notificationMessage;
    private string notificationClass = "alert-info";
    private string notificationIcon = "bi bi-info-circle";

    private async Task ProceedToCheckout()
{
    // Check if cart is empty
    if (CartService.CartItems.Count == 0)
    {
        ShowNotification(
            "Your cart is empty. Please add products before checkout.",
            "alert-warning",
            "bi bi-exclamation-triangle"
        );

        return;
    }

    // Check login status
    await CheckLoginStatus();

    if (!isLoggedIn)
    {
        ShowNotification(
            "Please login before proceeding to checkout.",
            "alert-warning",
            "bi bi-person-lock"
        );

        return;
    }

    // User is logged in and cart has items
    ShowNotification(
        $"Checkout started for {CartService.CartCount} item(s).",
        "alert-success",
        "bi bi-check-circle"
    );
        CartService.ClearCart();


}
    private async Task ShowNotification(
    string message,
    string alertClass,
    string icon)
{
    notificationMessage = message;
    notificationClass = alertClass;
    notificationIcon = icon;

    await InvokeAsync(StateHasChanged);

    await Task.Delay(3000);

    notificationMessage = null;

    await InvokeAsync(StateHasChanged);
}

protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckLoginStatus();

            StateHasChanged();
        }
    }
 private async Task CheckLoginStatus()
    {
        try
        {
           username = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "userName"
            );
            Console.WriteLine($"Username from localStorage: {username}");

            if (!string.IsNullOrWhiteSpace(username))
            {
                isLoggedIn = true;
            }
            else
            {
                isLoggedIn = false;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(
                $"Login check error: {ex.Message}"
            );

            isLoggedIn = false;
        }
    }
    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    
    

    protected override void OnInitialized()
    {
        CartService.OnCartChanged += OnCartChanged;
    }


    private void OnCartChanged()
    {
        InvokeAsync(StateHasChanged);
    }


    private void IncreaseQuantity(int productId)
    {
        CartService.IncreaseQuantity(productId);
    }


    private void DecreaseQuantity(int productId)
    {
        CartService.DecreaseQuantity(productId);
    }


    private void RemoveItem(int productId)
    {
        CartService.RemoveFromCart(productId);
    }


    public void Dispose()
    {
        CartService.OnCartChanged -= OnCartChanged;
    }

}