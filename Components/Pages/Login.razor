@page "/"
@rendermode InteractiveServer

@using System.Net.Http.Json

@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<div class="row justify-content-center align-items-center vh-100">
    <div class="col-md-4">
        <div class="card shadow border-0 rounded-4 p-4">

            <h3 class="text-center mb-4">User Login</h3>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger">
                    @errorMessage
                </div>
            }

            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text"
                       class="form-control rounded-pill px-3"
                       @bind="username"
                       placeholder="Enter username" />
            </div>

            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password"
                       class="form-control rounded-pill px-3"
                       @bind="password"
                       placeholder="Enter password" />
            </div>

            <button class="btn btn-primary w-100 rounded-pill py-2"
                    @onclick="HandleLogin"
                    disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Sign In</span>
                }
            </button>

            <div class="mt-3 text-center text-muted small">
                Test credentials:
                <br />
                Admin: <b>emilys</b> / <b>emilyspass</b>
                <br />
                User: <b>evelyns</b> / <b>evelynspass</b>
            </div>

        </div>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string errorMessage = "";
    private bool isLoading = false;

    private async Task HandleLogin()
    {
        Console.WriteLine("Button clicked");

        errorMessage = "";
        isLoading = true;

        try
        {
            var loginModel = new
            {
                username = username,
                password = password
            };

            Console.WriteLine($"Trying login with: {username}");

            var response = await Http.PostAsJsonAsync(
                "https://dummyjson.com/auth/login",
                loginModel
            );

            Console.WriteLine($"Response status code: {response.StatusCode}");

            if (response.IsSuccessStatusCode)
{
    var result = await response.Content.ReadFromJsonAsync<LoginResponse>();

    if (result != null && !string.IsNullOrEmpty(result.accessToken))
    {
        Console.WriteLine("Login successful!");

        // Save tokens
        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "authToken",
            result.accessToken
        );

        if (!string.IsNullOrEmpty(result.refreshToken))
        {
            await JS.InvokeVoidAsync(
                "localStorage.setItem",
                "refreshToken",
                result.refreshToken
            );
        }

        await JS.InvokeVoidAsync(
            "localStorage.setItem",
            "userName",
            result.username
        );

        // Get user information including role
        Http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue(
                "Bearer",
                result.accessToken
            );

        var meResponse = await Http.GetAsync(
            "https://dummyjson.com/auth/me"
        );

        if (meResponse.IsSuccessStatusCode)
        {
            var currentUser =
                await meResponse.Content.ReadFromJsonAsync<UserResponse>();

            if (currentUser != null)
            {
                var role = currentUser.role?.Trim().ToLowerInvariant();

                Console.WriteLine($"Username: {currentUser.username}");
                Console.WriteLine($"Role: {role}");

                await JS.InvokeVoidAsync(
                    "localStorage.setItem",
                    "userRole",
                    role ?? ""
                );

                if (role == "user")
                {
                    Navigation.NavigateTo("/shop");
                }
                else if (role == "admin")
                {
                    Navigation.NavigateTo("/admin-dashboard");
                }
                else
                {
                    errorMessage = "User role was not found.";
                }
            }
        }
        else
        {
            errorMessage = "Unable to retrieve user role.";
        }
    }
    else
    {
        errorMessage =
            "Login succeeded, but access token was not returned.";
    }
}
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            errorMessage = $"Login error: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private class UserResponse
{
    public int id { get; set; }
    public string username { get; set; } = "";
    public string email { get; set; } = "";
    public string firstName { get; set; } = "";
    public string lastName { get; set; } = "";
    public string gender { get; set; } = "";
    public string image { get; set; } = "";
    public string role { get; set; } = "";
}

    private class LoginResponse
    {
        public int id { get; set; }
        public string username { get; set; } = "";
        public string email { get; set; } = "";
        public string firstName { get; set; } = "";
        public string lastName { get; set; } = "";
        public string gender { get; set; } = "";
        public string image { get; set; } = "";
        public string role { get; set; } = "";
        public string accessToken { get; set; } = "";
        public string refreshToken { get; set; } = "";
    }
}