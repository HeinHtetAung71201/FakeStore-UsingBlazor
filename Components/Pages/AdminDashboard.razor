@page "/admin-dashboard"
@rendermode InteractiveServer

@using FakeWebStore.Models
@using FakeWebStore.Services

@inject HttpClient Http
@inject IJSRuntime JS
@inject IDashboardService DashboardService

<div class="container-fluid">
    <div class="row">
        <div class="col-12  col-xl-2 col-lg-3 vh-100 sideBar  d-none d-lg-block"
             style="background-image: linear-gradient(180deg, rgb(5, 39, 103) 0%, #3a0647 70%);">
            <AdminNavMenu />
        </div>
        <div class="col-12 col-xl-10 col-lg-9 vh-100 content  overflow-scroll">
            <div class="row sticky-top w-100">
                <div class="col-12 d-flex w-100 justify-content-end">
                    <div class="nav-bar   rounded d-flex justify-content-between align-items-center">
                        @if (isLoggedIn)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light border rounded-pill " type="button" @onclick="ToggleUserMenu">

                                    <i class="bi bi-person-circle me-1"></i>

                                    <span>@username</span>

                                    <i class="bi bi-chevron-down ms-1"></i>
                                </button>

                                @if (showUserMenu)
                                {
                                    <div class="position-absolute bg-white border rounded-3 shadow-sm p-2 mt-2"
                                         style="right: 0; min-width: 180px; z-index: 1100;">

                                        <div class="px-3 py-2 border-bottom">
                                            <small class="text-muted">Logged in as</small>
                                            <div class="fw-bold">
                                                @username
                                            </div>
                                        </div>

                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <a href="/" class="btn btn-outline-primary rounded-pill">
                                <i class="bi bi-person me-1"></i>
                                Login
                            </a>
                        }
                            
                    </div>
                </div>
            </div>
            <div class="row mt-3">
                <div class="col-12 mb-3 col-md-6 col-lg-6 col-xl-3 ">
                    <div class=" card status-card" onclick="link('https://www.google.com/')">
                        <div class=" card-body text-center">
                            <div class="row  align-items-center">
                                <div class="col-3">
                                    <i class="bi bi-bag-check-fill text-primary" style="font-size: 3em;"></i>
                                </div>
                                <div class="col-9 ">
                                    <p class="mb-0 h3 counter">@counts.TotalProducts</p>
                                    <p class="mb-0">Total Products</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mb-3 col-md-6 col-lg-6 col-xl-3 ">
                    <div class=" card status-card" onclick="link('')">
                        <div class=" card-body text-center">
                            <div class="row  align-items-center">
                                <div class="col-3">
                                    <i class="bi bi-people-fill text-primary" style="font-size: 3em;"></i>
                                </div>
                                <div class="col-9 ">
                                    <p class="mb-0 h3 counter">@counts.TotalUsers</p>
                                    <p class="mb-0">Total Customers</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 mb-3 col-md-6 col-lg-6 col-xl-3 ">
                    <div class=" card status-card" onclick="link('datalist.html')">
                        <div class=" card-body text-center">
                            <div class="row  align-items-center">
                                <div class="col-3">
                                    <i class="bi bi-box-seam-fill text-primary" style="font-size: 3em;"></i>
                                </div>
                                <div class="col-9 ">
                                    <p class="mb-0 h3 counter">@counts.TotalReceipts</p>
                                    <p class="mb-0">Total Receipts</p>
                                </div>
                            </div>
                        </div>
                    </div>
                        
                        
                        
                </div>
                <div class="col-12 mb-3 col-md-6 col-lg-6 col-xl-3 ">
                    <div class=" card status-card" onclick="link('https://www.google.com/')">
                        <div class=" card-body text-center">
                            <div class="row  align-items-center">
                                <div class="col-3">
                                    <i class="bi bi-geo-alt-fill text-primary" style="font-size: 3em;"></i>
                                </div>
                                <div class="col-9 ">
                                    <p class="mb-0 h3 counter">25</p>
                                    <p class="mb-0">Supported Location</p>
                                </div>
                            </div>
                        </div>
                    </div>
                        
                        
                </div>
                    
            </div>
            <div class="row align-items-end">

                <div class=" col-12 col-xl-5 col-md-6 ">
                    <div class="card shadow tooMuchMb">
                        <div class="card-body">
                            <div id="carouselExampleIndicators" class="carousel slide item-carosel"
                                 data-bs-ride="carousel">
            
                                <!-- Dynamic Indicators based on carouselProducts count -->
                                <div class="carousel-indicators" style="bottom: -38px;">
                                    @for (int i = 0; i < carouselProducts.Count; i++)
                                    {
                                        <button type="button" data-bs-target="#carouselExampleIndicators"
                                                data-bs-slide-to="@i" class="@(i == 0 ? "active bg-secondary" : "bg-secondary")"
                                                aria-current="@(i == 0 ? "true" : "false")" aria-label="Slide @(i + 1)">
                                        </button>
                                    }
                                </div>

                                <!-- Dynamic Carousel Inner -->
                                <div class="carousel-inner">
                                    @for (int i = 0; i < carouselProducts.Count; i++)
                                    {
                                        var product = carouselProducts[i];
                                        <div class="carousel-item @(i == 0 ? "active" : "")">
                                            <div class="item-card">
                                                <div class="d-flex justify-content-between align-items-end">
                                                    <div class="text-center">
                                                        <h4 class="">@product.Title</h4>
                                                        <p class="p-0">
                                                            $ @product.Price
                                                        </p>
                                                    </div>
                                                    <img src="@product.ImageUrl" alt="@product.Title" class="items-img">
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Optional Controls (Uncomment if you want prev/next buttons) -->
                                <!-- 
            <button class="carousel-control-prev" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Previous</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselExampleIndicators" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Next</span>
            </button> 
            -->
                            </div>
                        </div>
                    </div>
                </div>
                @* <div class="col-12 col-md-6 col-xl-7 col-lg-5">
                    <div class="card shadow ">
                        <div class="card-body">
                            <div class="d-flex align-items-center justify-content-between">
                                <h4 class="">Orders and Places</h4>
                                <i class=" feather-pie-chart" style="font-size: 30px;"></i>
                                    
                            </div>
                            <div class="doughnut" style="position:relative; height:480px; width: auto;">
                                    
                                <canvas id="doughnutChart" width="400"></canvas>

                            </div>
                        </div>
                    </div>
                </div> *@
                <div class=" col-12 col-md-6 col-xl-7 col-lg-5overflow-scroll">
                    <div class="card">
                        <div class="d-flex align-items-center justify-content-between p-2 ">
                            <h4 class="">Subscriber List</h4>
                            <i class=" feather-more-vertical" style="font-size: 30px;"></i>
                                
                        </div>
                        <div class=" table-responsive">
                            @if (isLoading)
                            {
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Loading...</span>
                                </div>
                                <p>Loading users from service...</p>
                            }
                            else if (users == null || !users.Any())
                            {
                                <p class="text-muted">No users found.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead>
                                            <tr>
                                                <th>ID</th>
                                                <th>First Name</th>
                                                <th>Last Name</th>
                                                <th>Username</th>
                                                <th>Email</th>
                                                <th>Phone</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var user in users)
                                            {
                                                <tr>
                                                    <td>@user.Id</td>
                                                    <td>@user.FirstName</td>
                                                    <td>@user.LastName</td>
                                                    <td>@user.Username</td>
                                                    <td>@user.Email</td>
                                                    <td>@user.Phone</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            @* <table class="table table-hover mb-0 subscriberList text-center">
                                    <thead>
                                       <tr>
                                          <th>Name</th>
                                          <th>UserName</th>
                                          <th>Email</th>
                                          <th>Phone</th>
                                       </tr>
                                    </thead>
                                    <tbody>
                                    @foreach (var subscriber in DummyUserResponse.)
                                    {
                                        <tr>
                                            <td>@subscriber.Name</td>
                                            <td>@subscriber.UserName</td>
                                            <td>@subscriber.Email</td>
                                            <td>@subscriber.Phone</td>
                                        </tr>
                                    }
                                    </tbody>
                                 </table> *@
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code
{
    private string? username;
    private bool isLoggedIn = false;
    private bool showUserMenu = false;
    

    // Use OnAfterRenderAsync for JS interop (localStorage)
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckLoginStatus();
            
            // Trigger a UI re-render since state changed after the initial render
            StateHasChanged();
        }
    }

    private async Task CheckLoginStatus()
    {
        try
        {
            username = await JS.InvokeAsync<string?>(
                "localStorage.getItem",
                "userName"
            );
            Console.WriteLine($"Retrieved username from localStorage: {username}");

            isLoggedIn = !string.IsNullOrWhiteSpace(username);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Login check error: {ex.Message}");
            isLoggedIn = false;
            username = null;
        }
    }

    private void ToggleUserMenu()
    {
        showUserMenu = !showUserMenu;
    }

    private DashboardCountsDto counts = new();
    private List<UserTableDto> users = new();
    private bool isLoading = true;

    private List<ProductItemDto> carouselProducts = new List<ProductItemDto>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            carouselProducts = await DashboardService.GetCarouselProductsAsync(4);
            counts = await DashboardService.GetDashboardCountsAsync();
            users = await DashboardService.GetUsersTableAsync(10);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }
}
